{
  "name": "angular-advanced-odontogram",
  "version": "2.6.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:styles": "tailwindcss -i projects/angular-advanced-odontogram/src/lib/core/index.css -o projects/angular-advanced-odontogram/styles.css --minify",
    "build:demo": "npm run build:styles && ng build demo",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:corpus && npm run test:ng",
    "test:corpus": "vitest run",
    "test:ng": "ng test angular-advanced-odontogram --watch=false",
    "test:watch": "vitest",
    "parity:capture": "PARITY_CAPTURE=1 vitest run projects/angular-advanced-odontogram/src/lib/core/__tests__/parity/capture.test.ts",
    "gen:assets": "node scripts/generate-svg-assets.mjs",
    "fhir:codesystem": "FHIR_CODESYSTEM_WRITE=1 vitest run projects/angular-advanced-odontogram/src/lib/core/__tests__/fhir-codesystem.test.ts projects/angular-advanced-odontogram/src/lib/core/__tests__/fhir-valuesets.test.ts",
    "docs": "typedoc"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "dompurify": "^3.4.13",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/fhir": "^0.0.44",
    "@types/jsdom": "^28.0.3",
    "autoprefixer": "^10.5.4",
    "jsdom": "^28.1.0",
    "ng-packagr": "^21.2.0",
    "postcss": "^8.5.26",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  }
}
